              },
              "2.5_in": {
                "type": "number"
              }
            },
            "required": [
              "1.5_in",
              "2_in",
              "2.5_in"
            ],
            "additionalProperties": false
          },
          "note": {
            "type": "string"
          },
          "link": {
            "type": "string",
            "description": "Page of calculatepool.com for the same calculation."
          }
        },
        "required": [
