        "openWorldHint": false,
        "title": "Pool pump flow rate"
      }
    },
    {
      "name": "heater_size",
      "title": "Pool heater BTU size",
      "description": "Use this when someone asks what size pool heater (BTU per hour) they need to raise the water a number of degrees Fahrenheit in a given time. Takes gallons, the temperature rise in °F and the hours (default 24), plus an optional buffer for surface heat loss (default 20 %, the same as the heater calculator on calculatepool.com). Returns the BTU/h required, the size with the buffer, the total BTU and the electric input of an equivalent heat pump. Not for heating cost per month or heater model recommendations.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "gallons": {
            "type": "number",
            "minimum": 100,
            "maximum": 2000000,
            "description": "Pool volume in US gallons (from pool_volume if the user gave dimensions)."
          },
          "temperature_rise_f": {
            "type": "number",
            "minimum": 1,
            "maximum": 60,
            "description": "Degrees Fahrenheit to raise the water."
          },
          "hours": {
            "type": "number",
            "minimum": 1,
            "maximum": 168,
            "description": "Hours to reach the temperature (default 24)."
          },
          "buffer_percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Extra capacity for surface heat loss while heating (default 20)."
          }
        },
        "required": [
          "gallons",
          "temperature_rise_f"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "gallons": {
            "type": "number"
          },
          "temperature_rise_f": {
            "type": "number"
          },
          "hours": {
            "type": "number"
          },
          "buffer_percent": {
            "type": "number"
          },
          "btu_per_hour_required": {
            "type": "integer"
          },
          "btu_per_hour_with_buffer": {
            "type": "integer"
          },
          "total_btu": {
            "type": "integer"
          },
          "heat_pump_kw_input_cop5": {
            "type": "number"
          },
          "note": {
            "type": "string"
          },
          "link": {
            "type": "string",
            "description": "Page of calculatepool.com for the same calculation."
          }
        },
        "required": [
          "gallons",
          "temperature_rise_f",
          "hours",
